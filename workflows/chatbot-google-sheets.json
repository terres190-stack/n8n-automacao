    {
      "parameters": {
        "jsCode": "let encontrou = false;\nlet resposta = null;\n\nconst perguntaUsuario = $items(\"Webhook\")[0].json.body.pergunta\n  .toLowerCase()\n  .replace(/[^\\w\\s]/g, \"\") // remove pontuação\n  .replace(/\\s+/g, \" \") // remove espaços duplicados\n  .trim();\n\nfor (const item of items) {\n  const palavrasChave = item.json[\"Palavra chave\"]\n    .toLowerCase()\n    .split(\",\");\n\n  for (const chave of palavrasChave) {\n    const termos = chave.trim().split(\" \");\n\n    const bate = termos.every(termo =>\n      perguntaUsuario.includes(termo)\n    );\n\n    if (bate) {\n      encontrou = true;\n      resposta = item.json[\"Respostas\"];\n      break;\n    }\n  }\n\n  if (encontrou) break;\n}\n\nreturn [\n  {\n    json: {\n      encontrou,\n      resposta\n    }\n  }\n];"
      },
