    {
      "parameters": {
        "jsCode": "function normalizarTexto(texto) {\n  return String(texto ?? \"\")\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .toLowerCase()\n    .replace(/[^\\p{L}\\p{N}\\s]/gu, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nconst webhookItems = $items(\"Receber pergunta\");\nconst perguntaOriginal = webhookItems[0]?.json?.body?.pergunta ?? \"\";\nconst perguntaUsuario = normalizarTexto(perguntaOriginal);\n\nif (!perguntaUsuario) {\n  return [\n    {\n      json: {\n        encontrou: true,\n        resposta: \"A pergunta não foi informada. Envie o campo 'pergunta' no corpo da solicitação.\"\n      }\n    }\n  ];\n}\n\nlet encontrou = false;\nlet resposta = null;\n\nfor (const item of items) {\n  const palavrasChave = String(item.json[\"Palavra chave\"] ?? \"\")\n    .split(\",\")\n    .map(normalizarTexto)\n    .filter(Boolean);\n\n  for (const chave of palavrasChave) {\n    const termos = chave\n      .split(\" \")\n      .map(termo => termo.trim())\n      .filter(Boolean);\n\n    const corresponde = termos.length > 0 && termos.every(termo =>\n      perguntaUsuario.includes(termo)\n    );\n\n    if (corresponde) {\n      encontrou = true;\n      resposta = item.json[\"Respostas\"] ??\n        \"Foi encontrada uma correspondência, mas não há uma resposta cadastrada.\";\n      break;\n    }\n  }\n\n  if (encontrou) {\n    break;\n  }\n}\n\nreturn [\n  {\n    json: {\n      encontrou,\n      resposta\n    }\n  }\n];"
      },
